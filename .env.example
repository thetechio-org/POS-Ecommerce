APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Use "daily" in production: "single" grows one unbounded file until the disk fills
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production — the session cookie must be HTTPS-only
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Seconds to wait on an unresponsive SMTP host before giving up
MAIL_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── API tokens (Sanctum) ─────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=
# Minutes until an issued API token expires (10080 = 7 days)
SANCTUM_TOKEN_EXPIRATION=10080
SANCTUM_TOKEN_PREFIX=

# ─── Payment gateways ─────────────────────────────────────────────────────────
# Supported: jazzcash | easypaisa
PAYMENT_GATEWAY=jazzcash

# IMPORTANT: *_SANDBOX defaults to TRUE. Leaving these unset in production sends
# real customers to the gateways' sandbox endpoints.
JAZZCASH_SANDBOX=true
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL="${APP_URL}/store/payment/jazzcash/callback"

EASYPAISA_SANDBOX=true
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_RETURN_URL="${APP_URL}/store/payment/easypaisa/callback"

# ─── SMS gateway ──────────────────────────────────────────────────────────────
# Supported: smspk | ecosms. Leave the credentials blank to disable SMS —
# messages are then written to the log instead of being sent.
SMS_GATEWAY=smspk

SMSPK_API_KEY=
SMSPK_SENDER_ID=POS

ECOSMS_USERNAME=
ECOSMS_PASSWORD=
ECOSMS_SENDER_ID=POS
